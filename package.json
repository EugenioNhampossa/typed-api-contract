{
  "name": "typed-api-contract",
  "version": "0.4.0",
  "description": "Typed REST contracts, fetch client, and TanStack Query hooks inferred from Zod route definitions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EugenioNhampossa/typed-api-contract.git"
  },
  "homepage": "https://eugenionhampossa.github.io/typed-api-contract/",
  "keywords": [
    "typescript",
    "zod",
    "rest",
    "contract",
    "tanstack-query",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react-query": {
      "types": "./dist/react-query/index.d.ts",
      "import": "./dist/react-query/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublish-only": "pnpm test && pnpm test:types && pnpm build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:types": "vitest --typecheck.only",
    "test:inference-budget": "node scripts/check-inference-budget.mjs",
    "pack:dry-run": "pnpm pack --dry-run",
    "pack:check": "node scripts/check-pack-contents.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.4"
}
